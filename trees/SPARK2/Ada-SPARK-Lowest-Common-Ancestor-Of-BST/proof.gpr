project Lowest_Common_Ancestor_Of_BST_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("lowest_common_ancestor_of_bst.ads", "lowest_common_ancestor_of_bst.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Lowest_Common_Ancestor_Of_BST_Proof;
