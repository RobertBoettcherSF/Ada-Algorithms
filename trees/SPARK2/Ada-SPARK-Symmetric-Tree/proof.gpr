project Symmetric_Tree_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("symmetric_tree.ads", "symmetric_tree.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Symmetric_Tree_Proof;
