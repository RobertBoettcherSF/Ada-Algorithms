project Proof is
   for Source_Dirs use (".");
   for Source_Files use ("binary_tree_preorder.ads", "binary_tree_preorder.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Proof;
