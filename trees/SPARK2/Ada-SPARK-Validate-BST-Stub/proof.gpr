project Validate_BST_Stub_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("validate_bst_stub.ads", "validate_bst_stub.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Validate_BST_Stub_Proof;
