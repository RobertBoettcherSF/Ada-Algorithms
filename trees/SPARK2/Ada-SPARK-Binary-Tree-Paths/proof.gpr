project Binary_Tree_Paths_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("binary_tree_paths.ads", "binary_tree_paths.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Binary_Tree_Paths_Proof;
