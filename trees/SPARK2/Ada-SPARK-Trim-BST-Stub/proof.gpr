project Trim_BST_Stub_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("trim_bst_stub.ads", "trim_bst_stub.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Trim_BST_Stub_Proof;
