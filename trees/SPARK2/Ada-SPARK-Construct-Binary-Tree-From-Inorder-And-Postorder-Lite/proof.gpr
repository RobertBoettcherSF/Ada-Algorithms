project Construct_Binary_Tree_From_Inorder_And_Postorder_Lite_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("construct_inorder_postorder_lite.ads", "construct_inorder_postorder_lite.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Construct_Binary_Tree_From_Inorder_And_Postorder_Lite_Proof;
