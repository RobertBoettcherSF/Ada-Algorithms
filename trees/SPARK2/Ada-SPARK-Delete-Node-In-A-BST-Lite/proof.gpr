project Proof is
   for Source_Dirs use (".");
   for Source_Files use ("delete_node_in_a_bst_lite.ads", "delete_node_in_a_bst_lite.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Proof;
