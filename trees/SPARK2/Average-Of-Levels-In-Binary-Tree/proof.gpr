project Average_Of_Levels_In_Binary_Tree_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("average_of_levels_in_binary_tree.ads", "average_of_levels_in_binary_tree.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Average_Of_Levels_In_Binary_Tree_Proof;
