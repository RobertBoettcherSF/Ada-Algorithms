project Count_Binary_Substrings_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("count_binary_substrings.ads", "count_binary_substrings.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Count_Binary_Substrings_Proof;
