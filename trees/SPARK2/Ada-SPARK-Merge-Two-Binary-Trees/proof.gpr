project Merge_Two_Binary_Trees_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("merge_two_binary_trees.ads", "merge_two_binary_trees.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Merge_Two_Binary_Trees_Proof;
