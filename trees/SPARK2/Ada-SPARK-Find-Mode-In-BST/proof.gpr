project Find_Mode_In_BST_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("find_mode_in_bst.ads", "find_mode_in_bst.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Find_Mode_In_BST_Proof;
