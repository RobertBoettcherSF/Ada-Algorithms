project Convert_BST_To_Greater_Tree_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("convert_bst_to_greater_tree.ads", "convert_bst_to_greater_tree.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Convert_BST_To_Greater_Tree_Proof;
