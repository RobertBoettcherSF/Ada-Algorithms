project Insert_Into_BST_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("insert_into_bst.ads", "insert_into_bst.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Insert_Into_BST_Proof;
