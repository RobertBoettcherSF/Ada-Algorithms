project Leaf_Similar_Trees_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("leaf_similar_trees.ads", "leaf_similar_trees.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Leaf_Similar_Trees_Proof;
