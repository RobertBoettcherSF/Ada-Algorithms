-- audio.gpr
-- GNAT Project File for compiling the Audio Compression codebase

project Audio is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnata", "-gnatwa");
      -- -gnata : Enable assertions (Required for test suite)
      -- -gnatwa : Enable all warnings
   end Compiler;
end Audio;
