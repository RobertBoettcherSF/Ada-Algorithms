project Huffman_Coding is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");
   package Prove is
      for Proof_Switches ("Ada") use ("--level=4");
   end Prove;
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
end Huffman_Coding;
