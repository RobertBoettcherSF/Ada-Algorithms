project PBKDF2_Project is
   for Source_Dirs use (".");
   for Object_Dir  use "obj";
   for Exec_Dir    use "bin";
   for Main        use ("tests.adb");

   package Compiler is
      -- Enforce all warnings and Ada 2022 compatibility
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022");
   end Compiler;
end PBKDF2_Project;
