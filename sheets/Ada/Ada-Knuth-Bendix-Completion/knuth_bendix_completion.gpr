project Knuth_Bendix_Completion is
   for Source_Dirs use (".");
   for Object_Dir  use "obj";
   for Exec_Dir    use "bin";
   for Main        use ("tests.adb");
   package Proof is
      for Switches ("Ada") use ("--level=2", "--timeout=60");
   end Proof;

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022");
   end Compiler;
end Knuth_Bendix_Completion;

