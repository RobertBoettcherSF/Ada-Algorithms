project Memory_Channel_Model is
   for Source_Dirs use (".");
   for Object_Dir  use "obj";
   for Exec_Dir    use "bin";
   for Main        use ("tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;

   package Builder is
      for Default_Switches ("Ada") use ("-g");
   end Builder;
end Memory_Channel_Model;
