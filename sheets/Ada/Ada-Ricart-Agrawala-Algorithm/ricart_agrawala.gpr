project Ricart_Agrawala is
   for Source_Dirs use ("src", ".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb", "tests.adb");

   package Compiler is
      -- -gnata enforces pragma Assert executions at runtime
      for Default_Switches ("Ada") use ("-g", "-gnatwa", "-gnata");
   end Compiler;
end Ricart_Agrawala;
