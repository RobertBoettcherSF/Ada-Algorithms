-- unrestricted.gpr
project Unrestricted is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb", "tests.adb");

   package Compiler is
      -- Enable Ada assertions (-gnata) for V&V test execution validation
      for Default_Switches ("Ada") use ("-gnata", "-g", "-O2");
   end Compiler;
end Unrestricted;
