project Computer_Vision is
   for Source_Dirs use (".");
   for Object_Dir  use "obj";
   for Exec_Dir    use "bin";
   for Main        use ("tests.adb");

   package Compiler is
      -- Enable all warnings and Ada 2022 features
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022");
   end Compiler;
end Computer_Vision;
