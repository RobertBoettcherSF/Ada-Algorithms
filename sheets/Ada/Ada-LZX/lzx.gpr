-- lzx.gpr
-- GNAT Project File for the LZX Verification Suite

project Lzx is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnata"); 
      -- -gnata enables pragma Assert for our V&V tests
   end Compiler;
end Lzx;
