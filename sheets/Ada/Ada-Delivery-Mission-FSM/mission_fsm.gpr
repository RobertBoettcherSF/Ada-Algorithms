project Mission_FSM is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ();

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--timeout=30");
   end Prove;
end Mission_FSM;
