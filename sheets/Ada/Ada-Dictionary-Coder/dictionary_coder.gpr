-- dictionary_coder.gpr
-- GNAT Project File

project Dictionary_Coder is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb", "tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnata");
   end Compiler;
end Dictionary_Coder;
