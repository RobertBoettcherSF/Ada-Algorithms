-- image_compression.gpr
-- GNAT Project File for Image Compression

project Image_Compression is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");
   
   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnata", "-gnatwa");
      -- -gnata enables assertions (required for the test suite)
      -- -gnatwa enables all warnings
   end Compiler;
end Image_Compression;
