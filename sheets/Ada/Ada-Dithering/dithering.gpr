-- dithering.gpr
-- GNAT Project File configured to work securely in the root directory.

project Dithering is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb", "tests.adb");

   package Compiler is
      for Switches ("Ada") use ("-g", "-O2", "-gnatwa", "-gnaty");
   end Compiler;
end Dithering;
