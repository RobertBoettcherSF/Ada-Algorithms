project Elliptic_Curve_Cryptography is
   for Source_Dirs use (".");
   for Object_Dir  use "obj";
   for Exec_Dir    use "bin";
   for Main        use ("tests.adb");

   package Compiler is
      -- Enable all warnings, treat as Ada 2022 (ISO/IEC 8652:2023), and enable contracts/assertions
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
end Elliptic_Curve_Cryptography;
