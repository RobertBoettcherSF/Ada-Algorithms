project Csprng is
   for Source_Dirs use (".");
   for Object_Dir  use "obj";
   for Exec_Dir    use "bin";
   for Main        use ("tests.adb");

   package Compiler is
      -- Treat warnings as errors where possible, apply Ada 2022/2023 capabilities
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022");
   end Compiler;
end Csprng;
