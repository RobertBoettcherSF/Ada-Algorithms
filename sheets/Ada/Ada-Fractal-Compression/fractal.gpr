-- fractal.gpr
-- GNAT Project File for compiling the root directory files
project Fractal is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb", "tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnata"); -- Enable assertions
   end Compiler;
end Fractal;
