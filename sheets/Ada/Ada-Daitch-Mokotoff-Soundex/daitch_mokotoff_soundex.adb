   ---------------------------------------------------------------------------
   -- Helpers
   ---------------------------------------------------------------------------

   function Is_Vowel (Ch : Character) return Boolean is
     (Ch = 'a' or else Ch = 'e' or else Ch = 'i'
        or else Ch = 'o' or else Ch = 'u');

   function To_Lower_Letter (Ch : Character) return Character is
   begin
      if Ch in 'A' .. 'Z' then
         return Character'Val
           (Character'Pos (Ch) - Character'Pos ('A') + Character'Pos ('a'));
      end if;
      return Ch;
   end To_Lower_Letter;

   --  Latin-1 accent foldings used by Commons Codec dmrules.txt (educational).
   function Fold_Latin1 (Ch : Character) return Character is
      C : constant Character := Ch;
   begin
      case Character'Pos (C) is
         when 16#DF# => return 's';  -- ß
         when 16#C0# | 16#C1# | 16#C2# | 16#C3# | 16#C4# | 16#C5# | 16#E0#
            | 16#E1# | 16#E2# | 16#E3# | 16#E4# | 16#E5# =>
            return 'a';
         when 16#C7# | 16#E7# => return 'c';
         when 16#C8# | 16#C9# | 16#CA# | 16#CB# | 16#E8# | 16#E9# | 16#EA#
            | 16#EB# =>
            return 'e';
         when 16#CC# | 16#CD# | 16#CE# | 16#CF# | 16#EC# | 16#ED# | 16#EE#
            | 16#EF# =>
            return 'i';
         when 16#D1# | 16#F1# => return 'n';
         when 16#D2# | 16#D3# | 16#D4# | 16#D5# | 16#D6# | 16#D8# | 16#F2#
            | 16#F3# | 16#F4# | 16#F5# | 16#F6# | 16#F8# =>
            return 'o';
         when 16#D9# | 16#DA# | 16#DB# | 16#DC# | 16#F9# | 16#FA# | 16#FB#
            | 16#FC# =>
            return 'u';
         when 16#DD# | 16#FD# | 16#FF# => return 'y';
         when 16#D0# => return 'd';  -- Ð
         when 16#F0# => return 'd';  -- ð
         when 16#DE# | 16#FE# => return 'b';  -- Þ þ
         when others =>
            return To_Lower_Letter (C);
      end case;
   end Fold_Latin1;

   function Is_Letter_AZ (Ch : Character) return Boolean is
     (Ch in 'a' .. 'z' or else Ch in 'A' .. 'Z');

   function Clean (Name : String) return String is
      Buf : String (1 .. Name'Length);
      N   : Natural := 0;
   begin
      for I in Name'Range loop
         declare
            Ch0 : constant Character := Name (I);
            Ch  : Character;
         begin
            if Is_Letter_AZ (Ch0)
              or else Character'Pos (Ch0) >= 16#C0#
            then
               Ch := Fold_Latin1 (Ch0);
               if Ch in 'a' .. 'z' then
                  N := N + 1;
                  Buf (N) := Ch;
               end if;
            end if;
         end;
      end loop;
      return Buf (1 .. N);
   end Clean;

   function Ends_With (Hay : String; Needle : String) return Boolean is
   begin
      if Needle'Length = 0 then
         return True;
      end if;
      if Hay'Length < Needle'Length then
         return False;
      end if;
      return Hay (Hay'Last - Needle'Length + 1 .. Hay'Last) = Needle;
   end Ends_With;

   ---------------------------------------------------------------------------
   -- Branch state
   ---------------------------------------------------------------------------

   type Branch_State is record
      Digit_Buf : String (1 .. Code_Length) := [others => '0'];
      Len    : Natural := 0;
      Last   : String (1 .. Max_Rep) := [others => ' '];
      Last_L : Natural := 0;  -- 0 means last is unset (null); empty NC uses
                              -- Last_L = 0 with a sentinel via Has_Last
      Has_Last : Boolean := False;
   end record;

   type Branch_Array is array (1 .. Max_Codes) of Branch_State;

   procedure Process_Replacement
     (B     : in out Branch_State;
      Rep   : String;
      Force : Boolean)
   is
      Append : Boolean;
   begin
      if not B.Has_Last then
         Append := True;
      elsif Force then
         Append := True;
      else
         Append := not Ends_With (B.Last (1 .. B.Last_L), Rep);
      end if;

      if Append and then B.Len < Code_Length and then Rep'Length > 0 then
         declare
            Take : constant Natural :=
              Natural'Min (Rep'Length, Code_Length - B.Len);
         begin
            for K in 1 .. Take loop
               B.Len := B.Len + 1;
               B.Digit_Buf (B.Len) := Rep (Rep'First + K - 1);
            end loop;
         end;
      end if;

      B.Has_Last := True;
      B.Last_L := Rep'Length;
      for K in 1 .. Max_Rep loop
         if K <= Rep'Length then
            B.Last (K) := Rep (Rep'First + K - 1);
         else
            B.Last (K) := ' ';
         end if;
      end loop;
   end Process_Replacement;

   function Finished (B : Branch_State) return Code_String is
      R : Code_String := [others => '0'];
   begin
      for K in 1 .. B.Len loop
         R (K) := B.Digit_Buf (K);
      end loop;
      return R;
   end Finished;

   function Code_Key (B : Branch_State) return String is
     (B.Digit_Buf (1 .. B.Len));

   ---------------------------------------------------------------------------
   -- Core encoder
   ---------------------------------------------------------------------------

   function Soundex_Core
     (Cleaned  : String;
      Branching : Boolean) return Code_List
   is
      Curr      : Branch_Array;
      Curr_N    : Natural := 1;
      Next_B    : Branch_Array;
      Next_N    : Natural;
      Last_Char : Character := ASCII.NUL;
      Index     : Natural := Cleaned'First;
   begin
      Curr (1) := (others => <>);

      while Index <= Cleaned'Last loop
         declare
            Ch      : constant Character := Cleaned (Index);
            Start_I : constant Natural := First_Start (Ch);
            Count_I : constant Natural := First_Count (Ch);
            Matched : Boolean := False;
         begin
            if Start_I = 0 then
               Last_Char := Ch;
               Index := Index + 1;
            else
               Next_N := 0;
               for R_Idx in Start_I .. Start_I + Count_I - 1 loop
                  declare
                     Rule : Rule_Rec renames Rules (R_Idx);
                     Ok   : Boolean := True;
                  begin
                     if Index + Rule.Pat_Len - 1 > Cleaned'Last then
                        Ok := False;
                     else
                        for K in 1 .. Rule.Pat_Len loop
                           if Cleaned (Index + K - 1) /= Rule.Pat (K) then
                              Ok := False;
                              exit;
                           end if;
                        end loop;
                     end if;

                     if Ok then
                        Matched := True;
                        declare
                           At_Start : constant Boolean :=
                             Last_Char = ASCII.NUL;
                           Next_Ix  : constant Natural :=
                             Index + Rule.Pat_Len;
                           Before_V : constant Boolean :=
                             Next_Ix <= Cleaned'Last
                             and then Is_Vowel (Cleaned (Next_Ix));
                           Alts     : Context_Alts;
                           Force    : constant Boolean :=
                             (Last_Char = 'm' and then Ch = 'n')
                             or else (Last_Char = 'n' and then Ch = 'm');
                        begin
                           if At_Start then
                              Alts := Rule.Start;
                           elsif Before_V then
                              Alts := Rule.Before;
                           else
                              Alts := Rule.Other;
                           end if;

                           for B_Idx in 1 .. Curr_N loop
                              for A_Idx in 1 .. Positive (Alts.Count) loop
                                 declare
                                    Rep_L : constant Natural :=
                                      Alts.Lens (A_Idx);
                                    Rep   : constant String :=
                                      Alts.Text (A_Idx) (1 .. Rep_L);
                                    NB    : Branch_State := Curr (B_Idx);
                                 begin
                                    Process_Replacement (NB, Rep, Force);
                                    if Branching then
                                       --  Dedup by digits so far (Commons
                                       --  LinkedHashSet on Branch.toString).
                                       declare
                                          Key   : constant String :=
                                            Code_Key (NB);
                                          Found : Boolean := False;
                                       begin
                                          for J in 1 .. Next_N loop
                                             if Code_Key (Next_B (J)) = Key
                                             then
                                                Found := True;
                                                exit;
                                             end if;
                                          end loop;
                                          if not Found
                                            and then Next_N < Max_Codes
                                          then
                                             Next_N := Next_N + 1;
                                             Next_B (Next_N) := NB;
                                          end if;
                                       end;
                                    else
                                       Curr (B_Idx) := NB;
                                       exit;  -- first alt only
                                    end if;
                                 end;
                              end loop;
                              if not Branching then
                                 exit;
                              end if;
                           end loop;

                           if Branching then
                              Curr_N := Next_N;
                              for J in 1 .. Curr_N loop
                                 Curr (J) := Next_B (J);
                              end loop;
                           end if;

                           Index := Index + Rule.Pat_Len - 1;
                        end;
                        exit;  -- first matching rule
                     end if;
                  end;
               end loop;

               Last_Char := Ch;
               Index := Index + 1;
               pragma Unreferenced (Matched);
            end if;
         end;
      end loop;

      declare
         Acc    : Code_List (1 .. Curr_N) := [others => [others => '0']];
         Seen_N : Natural := 0;
      begin
         --  Unique finished codes, preserve order
         for I in 1 .. Curr_N loop
            declare
               Code  : constant Code_String := Finished (Curr (I));
               Found : Boolean := False;
            begin
               for J in 1 .. Seen_N loop
                  if Acc (J) = Code then
                     Found := True;
                     exit;
                  end if;
               end loop;
               if not Found then
                  Seen_N := Seen_N + 1;
                  Acc (Seen_N) := Code;
               end if;
            end;
         end loop;
         return Acc (1 .. Seen_N);
      end;
   end Soundex_Core;

   ---------------------------------------------------------------------------
   -- Public API
   ---------------------------------------------------------------------------

   function Encode (Name : String) return Code_List is
      Cleaned : constant String := Clean (Name);
   begin
      if Name'Length = 0 or else Name'Length > Max_Len then
         raise Invalid_Argument;
      end if;
      if Cleaned'Length = 0 then
         raise Invalid_Argument;
      end if;
      return Soundex_Core (Cleaned, Branching => True);
   end Encode;

   function Primary_Encode (Name : String) return Code_String is
      Cleaned : constant String := Clean (Name);
   begin
      if Name'Length = 0 or else Name'Length > Max_Len then
         raise Invalid_Argument;
      end if;
      if Cleaned'Length = 0 then
         raise Invalid_Argument;
      end if;
      declare
         Codes : constant Code_List :=
           Soundex_Core (Cleaned, Branching => False);
      begin
         return Codes (Codes'First);
      end;
   end Primary_Encode;

   function Codes_Match (A, B : String) return Boolean is
      CA : constant Code_List := Encode (A);
      CB : constant Code_List := Encode (B);
   begin
      for I in CA'Range loop
         for J in CB'Range loop
            if CA (I) = CB (J) then
               return True;
            end if;
         end loop;
      end loop;
      return False;
   end Codes_Match;

end Daitch_Mokotoff_Soundex;
