project Perceptron is
   for Source_Dirs use (".");
   for Object_Dir  use "obj";
   for Exec_Dir    use "bin";
   for Main        use ("tests.adb");

   package Compiler is
      -- -gnatwa: all warnings
      -- -gnat2022: use Ada 2022 features (compatible with Ada 2023 constructs used)
      -- -gnata: enable assertions and preconditions
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
end Perceptron;
