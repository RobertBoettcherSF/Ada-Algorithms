project Chandy_Lamport is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb", "tests.adb");

   package Compiler is
      -- Enable assertions (-gnata) mandatory for test execution
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnata", "-gnat12");
   end Compiler;
end Chandy_Lamport;
