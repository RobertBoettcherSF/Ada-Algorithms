project Course_Schedule_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("course_schedule.ads", "course_schedule.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Course_Schedule_Proof;
