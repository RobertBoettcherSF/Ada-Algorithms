project SparseVectorDotStub_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("sparse_vector_dot_stub.ads", "sparse_vector_dot_stub.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end SparseVectorDotStub_Proof;
