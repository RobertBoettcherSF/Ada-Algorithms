-- dithering.gpr
-- GNAT Project File configured to work securely in the root directory.

project Dithering is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb", "tests.adb", "tests_golden.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnatwa", "-gnaty", "-gnata");
   end Compiler;
end Dithering;
