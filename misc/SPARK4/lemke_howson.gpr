project Lemke_Howson is
   for Source_Dirs use (".");
   for Object_Dir  use "obj";
   for Exec_Dir    use "bin";
   for Main        use ("tests.adb");

   package Proof is
      for Proof_Level use "4";
   end Proof;

   package Compiler is
      for Default_Switches ("Ada") use (
         "-gnat2022",
         "-gnatwa",
         "-gnata"
      );
   end Compiler;
end Lemke_Howson;
