-- GPR file for the SSTF Demo Program
-- This project file compiles and runs the demonstration program

project SSTF_Demo is
   for Source_Dirs use ("..", ".");
   for Object_Dir use "../obj/demo";
   for Exec_Dir use "../bin";

   for Main use ("sstf_demo.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-gnata", "-gnato", "-gnatwa");
   end Compiler;

   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end SSTF_Demo;
