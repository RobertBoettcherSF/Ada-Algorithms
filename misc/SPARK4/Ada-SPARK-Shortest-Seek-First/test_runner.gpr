-- GPR file for the SSTF Test Runner
-- This project file compiles and runs the test suite

project Test_Runner is
   for Source_Dirs use ("tests", ".");
   for Object_Dir use "obj/test";
   for Exec_Dir use "bin";

   for Main use ("tests/test_runner.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-gnata", "-gnato", "-gnatwa");
   end Compiler;

   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Test_Runner;
