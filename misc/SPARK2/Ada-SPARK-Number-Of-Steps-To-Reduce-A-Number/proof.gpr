project Number_Of_Steps_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("number_of_steps.ads", "number_of_steps.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Number_Of_Steps_Proof;
