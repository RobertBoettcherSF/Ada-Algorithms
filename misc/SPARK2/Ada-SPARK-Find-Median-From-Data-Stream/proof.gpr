project Find_Median_From_Data_Stream_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("find_median_from_data_stream.ads", "find_median_from_data_stream.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Find_Median_From_Data_Stream_Proof;
