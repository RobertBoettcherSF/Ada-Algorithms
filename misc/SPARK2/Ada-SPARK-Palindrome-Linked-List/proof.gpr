project Palindrome_Linked_List_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("palindrome_linked_list.ads", "palindrome_linked_list.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Palindrome_Linked_List_Proof;
