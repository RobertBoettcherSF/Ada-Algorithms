project Minimum_Cost_To_Move_Chips_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("minimum_cost_to_move_chips.ads", "minimum_cost_to_move_chips.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Minimum_Cost_To_Move_Chips_Proof;
