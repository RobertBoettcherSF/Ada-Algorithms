project Split_Array_Largest_Sum_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("split_array_largest_sum.ads", "split_array_largest_sum.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Split_Array_Largest_Sum_Proof;
