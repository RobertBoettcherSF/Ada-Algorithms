project Remove_Adjacent_Duplicates_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("remove_adjacent_duplicates.ads", "remove_adjacent_duplicates.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Remove_Adjacent_Duplicates_Proof;
