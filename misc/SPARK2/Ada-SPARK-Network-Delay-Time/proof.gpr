project Network_Delay_Time_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("network_delay_time.ads", "network_delay_time.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Network_Delay_Time_Proof;
