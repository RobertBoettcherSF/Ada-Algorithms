project Majority_Element_II_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("majority_element_ii.ads", "majority_element_ii.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Majority_Element_II_Proof;
