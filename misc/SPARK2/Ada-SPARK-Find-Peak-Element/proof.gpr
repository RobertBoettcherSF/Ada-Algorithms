project Find_Peak_Element_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("find_peak_element.ads", "find_peak_element.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Find_Peak_Element_Proof;
