project Counting_Bits_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("counting_bits.ads", "counting_bits.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Counting_Bits_Proof;
