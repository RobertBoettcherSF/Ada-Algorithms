project Three_Sum_Closest_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("three_sum_closest.ads", "three_sum_closest.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Three_Sum_Closest_Proof;
