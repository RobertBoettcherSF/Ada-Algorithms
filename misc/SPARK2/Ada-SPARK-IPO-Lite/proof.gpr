project Ipo_Lite_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("ipo_lite.ads", "ipo_lite.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Ipo_Lite_Proof;
