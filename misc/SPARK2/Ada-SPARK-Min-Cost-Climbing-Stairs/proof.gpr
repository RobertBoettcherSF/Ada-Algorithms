project Min_Cost_Climbing_Stairs_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("min_cost_climbing_stairs.ads", "min_cost_climbing_stairs.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Min_Cost_Climbing_Stairs_Proof;
