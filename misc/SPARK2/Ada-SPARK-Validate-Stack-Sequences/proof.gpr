project Validate_Stack_Sequences_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("validate_stack_sequences.ads", "validate_stack_sequences.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Validate_Stack_Sequences_Proof;
