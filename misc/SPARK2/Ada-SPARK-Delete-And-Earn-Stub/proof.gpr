project Delete_And_Earn_Stub_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("delete_and_earn_stub.ads", "delete_and_earn_stub.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Delete_And_Earn_Stub_Proof;
