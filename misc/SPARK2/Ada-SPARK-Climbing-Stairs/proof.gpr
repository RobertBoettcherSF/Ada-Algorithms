project Climbing_Stairs_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("climbing_stairs.ads", "climbing_stairs.adb");
   for Object_Dir use "obj";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
end Climbing_Stairs_Proof;
