project Ugly_Number_II_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("ugly_powers.ads", "ugly_powers.adb", "ugly_number_ii.ads", "ugly_number_ii.adb");
   for Object_Dir use "obj";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Ugly_Number_II_Proof;
