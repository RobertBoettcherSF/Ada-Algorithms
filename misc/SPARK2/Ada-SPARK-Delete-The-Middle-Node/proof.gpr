project Delete_The_Middle_Node_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("delete_the_middle_node.ads", "delete_the_middle_node.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Delete_The_Middle_Node_Proof;
