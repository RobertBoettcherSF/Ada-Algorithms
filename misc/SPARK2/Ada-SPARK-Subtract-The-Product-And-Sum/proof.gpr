project Subtract_Product_Sum_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("subtract_product_sum.ads", "subtract_product_sum.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Subtract_Product_Sum_Proof;
