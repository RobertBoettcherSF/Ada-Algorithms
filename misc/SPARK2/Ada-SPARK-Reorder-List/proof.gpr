project Reorder_List_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("reorder_list.ads", "reorder_list.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Reorder_List_Proof;
