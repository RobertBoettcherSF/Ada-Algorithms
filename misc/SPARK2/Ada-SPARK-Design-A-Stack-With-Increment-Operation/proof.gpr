project Design_A_Stack_With_Increment_Operation_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("design_a_stack_with_increment_operation.ads", "design_a_stack_with_increment_operation.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Design_A_Stack_With_Increment_Operation_Proof;
