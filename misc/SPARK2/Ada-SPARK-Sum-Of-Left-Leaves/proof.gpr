project Sum_Of_Left_Leaves_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("sum_of_left_leaves.ads", "sum_of_left_leaves.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Sum_Of_Left_Leaves_Proof;
