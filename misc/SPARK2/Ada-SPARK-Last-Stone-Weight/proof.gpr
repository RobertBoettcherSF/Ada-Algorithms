project Last_Stone_Weight_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("last_stone_weight.ads", "last_stone_weight.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Last_Stone_Weight_Proof;
