project Capacity_To_Ship_Packages_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("capacity_to_ship_packages.ads", "capacity_to_ship_packages.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Capacity_To_Ship_Packages_Proof;
