project Convert_1D_Array_Into_2D_Array_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("convert_1d_array_into_2d_array.ads", "convert_1d_array_into_2d_array.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Convert_1D_Array_Into_2D_Array_Proof;
