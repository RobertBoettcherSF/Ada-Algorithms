project Find_The_Duplicate_Number_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("find_the_duplicate_number.ads", "find_the_duplicate_number.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Find_The_Duplicate_Number_Proof;
