project Seat_Reservation_Manager_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("seat_reservation_manager.ads", "seat_reservation_manager.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Seat_Reservation_Manager_Proof;
