project Least_Common_Multiple_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("least_common_multiple.ads", "least_common_multiple.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Least_Common_Multiple_Proof;
