project Top_Nodes_Algorithm_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("top_nodes_algorithm.ads", "top_nodes_algorithm.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Top_Nodes_Algorithm_Proof;
