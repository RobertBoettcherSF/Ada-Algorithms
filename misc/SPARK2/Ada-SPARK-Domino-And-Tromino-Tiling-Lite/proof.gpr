project Proof is
   for Source_Dirs use (".");
   for Source_Files use ("domino_and_tromino_tiling_lite.ads", "domino_and_tromino_tiling_lite.adb");
   for Object_Dir use "obj";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
end Proof;
