project Defanging_IP_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("defanging_ip.ads", "defanging_ip.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Defanging_IP_Proof;
