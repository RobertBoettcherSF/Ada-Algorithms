project Min_Max_Normalize_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("min_max_normalize.ads", "min_max_normalize.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Min_Max_Normalize_Proof;
