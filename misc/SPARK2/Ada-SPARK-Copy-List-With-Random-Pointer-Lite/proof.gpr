project Copy_List_With_Random_Pointer_Lite_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("copy_list_with_random_pointer_lite.ads", "copy_list_with_random_pointer_lite.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Copy_List_With_Random_Pointer_Lite_Proof;
