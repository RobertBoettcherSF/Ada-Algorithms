project Shortest_Word_Distance_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("shortest_word_distance.ads", "shortest_word_distance.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Shortest_Word_Distance_Proof;
