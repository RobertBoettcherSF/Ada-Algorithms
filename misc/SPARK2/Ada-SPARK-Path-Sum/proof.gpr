project Path_Sum_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("path_sum.ads", "path_sum.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Path_Sum_Proof;
