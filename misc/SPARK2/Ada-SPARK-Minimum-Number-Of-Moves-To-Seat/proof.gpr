project Minimum_Number_Of_Moves_To_Seat_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("minimum_number_of_moves_to_seat.ads", "minimum_number_of_moves_to_seat.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Minimum_Number_Of_Moves_To_Seat_Proof;
