project Formed_Words_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("formed_words.ads", "formed_words.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Formed_Words_Proof;
