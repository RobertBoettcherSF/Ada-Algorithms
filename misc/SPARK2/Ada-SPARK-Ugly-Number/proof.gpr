project Ugly_Number_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("ugly_number.ads", "ugly_number.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Ugly_Number_Proof;
