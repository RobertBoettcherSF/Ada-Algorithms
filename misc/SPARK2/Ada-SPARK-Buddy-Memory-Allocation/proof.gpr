project Buddy_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("buddy_memory_allocation.ads", "buddy_memory_allocation.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Buddy_Proof;
