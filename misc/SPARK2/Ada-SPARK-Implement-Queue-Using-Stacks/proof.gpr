project Implement_Queue_Using_Stacks_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("implement_queue_using_stacks.ads", "implement_queue_using_stacks.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Implement_Queue_Using_Stacks_Proof;
