project First_Bad_Version_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("first_bad_version.ads", "first_bad_version.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end First_Bad_Version_Proof;
