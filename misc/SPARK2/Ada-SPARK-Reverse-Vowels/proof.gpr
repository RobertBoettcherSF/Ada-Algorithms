project Reverse_Vowels_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("reverse_vowels.ads", "reverse_vowels.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Reverse_Vowels_Proof;
