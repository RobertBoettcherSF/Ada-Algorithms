project Get_Maximum_In_Generated_Array_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("get_maximum_in_generated_array.ads", "get_maximum_in_generated_array.adb");
   for Object_Dir use "obj";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Get_Maximum_In_Generated_Array_Proof;
