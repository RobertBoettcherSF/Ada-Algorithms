project Koko_Eating_Bananas_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("koko_eating_bananas.ads", "koko_eating_bananas.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Koko_Eating_Bananas_Proof;
