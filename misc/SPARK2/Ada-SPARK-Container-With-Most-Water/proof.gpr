project Container_With_Most_Water_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("container_with_most_water.ads", "container_with_most_water.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Container_With_Most_Water_Proof;
