project Alien_Dictionary_Stub_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("alien_dictionary_stub.ads", "alien_dictionary_stub.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Alien_Dictionary_Stub_Proof;
