project TimeMapStub_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("time_map_stub.ads", "time_map_stub.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end TimeMapStub_Proof;
