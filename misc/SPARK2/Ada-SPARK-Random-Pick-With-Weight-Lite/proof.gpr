project Random_Pick_With_Weight_Lite_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("random_pick_with_weight_lite.ads", "random_pick_with_weight_lite.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Random_Pick_With_Weight_Lite_Proof;
