project Proof is
   for Source_Dirs use (".");
   for Source_Files use ("middle_of_the_linked_list.ads", "middle_of_the_linked_list.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Proof;
