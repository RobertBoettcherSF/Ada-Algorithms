project Matchsticks_To_Square_Lite_Proof is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Source_Files use ("matchsticks_to_square_lite.ads", "matchsticks_to_square_lite.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Matchsticks_To_Square_Lite_Proof;
