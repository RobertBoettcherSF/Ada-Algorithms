project Robot_Origin_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("robot_origin.ads", "robot_origin.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Robot_Origin_Proof;
