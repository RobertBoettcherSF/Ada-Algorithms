project HitCounterStubProof is
   for Source_Dirs use (".");
   for Source_Files use ("hit_counter_stub.ads", "hit_counter_stub.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end HitCounterStubProof;
