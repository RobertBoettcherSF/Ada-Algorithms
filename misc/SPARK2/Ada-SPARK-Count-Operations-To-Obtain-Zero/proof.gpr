project Count_Operations_To_Obtain_Zero_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("count_operations_to_obtain_zero.ads", "count_operations_to_obtain_zero.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Count_Operations_To_Obtain_Zero_Proof;
