project Top_K_Frequent_Elements_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("top_k_frequent_elements.ads", "top_k_frequent_elements.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Top_K_Frequent_Elements_Proof;
