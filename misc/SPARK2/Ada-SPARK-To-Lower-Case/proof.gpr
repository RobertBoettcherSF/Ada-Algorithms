project To_Lower_Case_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("to_lower_case.ads", "to_lower_case.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end To_Lower_Case_Proof;
