project Sudoku_Solver_Lite_Proof is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Source_Files use ("sudoku_solver_lite.ads", "sudoku_solver_lite.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Sudoku_Solver_Lite_Proof;
