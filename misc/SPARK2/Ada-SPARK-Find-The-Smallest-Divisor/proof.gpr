project Find_The_Smallest_Divisor_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("find_the_smallest_divisor.ads", "find_the_smallest_divisor.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Find_The_Smallest_Divisor_Proof;
