project Exclusive_Time_Of_Functions_Lite is
   for Source_Dirs use (".");
   for Main use ("tests.adb");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Exclusive_Time_Of_Functions_Lite;
