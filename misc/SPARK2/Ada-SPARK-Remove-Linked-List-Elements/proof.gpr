project Remove_Linked_List_Elements_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("remove_linked_list_elements.ads", "remove_linked_list_elements.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Remove_Linked_List_Elements_Proof;
