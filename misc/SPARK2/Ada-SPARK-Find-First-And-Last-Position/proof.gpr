project Find_First_And_Last_Position_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("find_first_and_last_position.ads", "find_first_and_last_position.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Find_First_And_Last_Position_Proof;
