project Find_K_Closest_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("find_k_closest.ads", "find_k_closest.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Find_K_Closest_Proof;
