project Max_Stack_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("max_stack.ads", "max_stack.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Max_Stack_Proof;
