project Rate_Monotonic_Scheduling_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("rate_monotonic_scheduling.ads", "rate_monotonic_scheduling.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Rate_Monotonic_Scheduling_Proof;
