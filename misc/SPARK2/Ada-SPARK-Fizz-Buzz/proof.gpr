project Fizz_Buzz_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("fizz_buzz.ads", "fizz_buzz.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Fizz_Buzz_Proof;
