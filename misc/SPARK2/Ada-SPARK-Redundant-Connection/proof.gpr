project Redundant_Connection_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("redundant_connection.ads", "redundant_connection.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Redundant_Connection_Proof;
