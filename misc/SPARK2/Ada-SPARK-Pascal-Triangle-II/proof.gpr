project Pascal_Triangle_II_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("pascal_triangle_ii.ads", "pascal_triangle_ii.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Pascal_Triangle_II_Proof;
