project Excel_Sheet_Column_Title_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("excel_sheet_column_title.ads", "excel_sheet_column_title.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Excel_Sheet_Column_Title_Proof;
