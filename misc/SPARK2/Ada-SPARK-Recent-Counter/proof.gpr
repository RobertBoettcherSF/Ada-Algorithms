project Recent_Counter_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("recent_counter.ads", "recent_counter.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Recent_Counter_Proof;
