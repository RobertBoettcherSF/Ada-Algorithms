project Baseball_Game_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("baseball_game.ads", "baseball_game.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Baseball_Game_Proof;
