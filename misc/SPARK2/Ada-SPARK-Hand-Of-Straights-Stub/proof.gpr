project Hand_Of_Straights_Stub_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("hand_of_straights_stub.ads", "hand_of_straights_stub.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Hand_Of_Straights_Stub_Proof;
