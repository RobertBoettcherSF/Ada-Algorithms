project One_Hot_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("one_hot.ads", "one_hot.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end One_Hot_Proof;
