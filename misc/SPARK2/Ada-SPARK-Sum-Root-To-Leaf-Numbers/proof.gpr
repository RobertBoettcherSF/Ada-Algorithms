project Sum_Root_To_Leaf_Numbers_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("sum_root_to_leaf_numbers.ads", "sum_root_to_leaf_numbers.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Sum_Root_To_Leaf_Numbers_Proof;
