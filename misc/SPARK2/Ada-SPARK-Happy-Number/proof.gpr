project Happy_Number_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("happy_number.ads", "happy_number.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Happy_Number_Proof;
