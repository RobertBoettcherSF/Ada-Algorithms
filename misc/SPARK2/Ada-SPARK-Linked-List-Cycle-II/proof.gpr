project Linked_List_Cycle_II_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("linked_list_cycle_ii.ads", "linked_list_cycle_ii.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Linked_List_Cycle_II_Proof;
