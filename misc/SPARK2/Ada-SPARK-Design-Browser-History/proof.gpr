project Design_Browser_History_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("design_browser_history.ads", "design_browser_history.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Design_Browser_History_Proof;
