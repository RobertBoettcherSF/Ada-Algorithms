project Crawler_Log_Folder_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("crawler_log_folder.ads", "crawler_log_folder.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Crawler_Log_Folder_Proof;
