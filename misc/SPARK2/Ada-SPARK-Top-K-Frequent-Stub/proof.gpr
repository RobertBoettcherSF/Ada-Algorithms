project Top_K_Frequent_Stub_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("top_k_frequent_stub.ads", "top_k_frequent_stub.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Top_K_Frequent_Stub_Proof;
