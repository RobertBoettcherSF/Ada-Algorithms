project MovingAverageFromDataStreamProof is
   for Source_Dirs use (".");
   for Source_Files use ("moving_average_from_data_stream.ads", "moving_average_from_data_stream.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end MovingAverageFromDataStreamProof;
