project Design_Circular_Queue_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("design_circular_queue.ads", "design_circular_queue.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Design_Circular_Queue_Proof;
