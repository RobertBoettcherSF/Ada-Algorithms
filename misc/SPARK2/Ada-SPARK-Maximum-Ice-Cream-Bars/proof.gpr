project Maximum_Ice_Cream_Bars_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("maximum_ice_cream_bars.ads", "maximum_ice_cream_bars.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Maximum_Ice_Cream_Bars_Proof;
