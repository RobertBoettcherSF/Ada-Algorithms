project Subarrays_With_K_Different_Integers_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("subarrays_with_k_different_integers.ads", "subarrays_with_k_different_integers.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Subarrays_With_K_Different_Integers_Proof;
