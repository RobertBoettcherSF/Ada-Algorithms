project Arranging_Coins_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("arranging_coins.ads", "arranging_coins.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Arranging_Coins_Proof;
