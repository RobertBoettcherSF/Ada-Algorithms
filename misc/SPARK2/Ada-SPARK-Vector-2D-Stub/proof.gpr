project Vector_2D_Stub_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("vector_2d_stub.ads", "vector_2d_stub.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Vector_2D_Stub_Proof;
