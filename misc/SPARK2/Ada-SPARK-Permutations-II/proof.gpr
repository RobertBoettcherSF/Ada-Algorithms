project Permutations_II_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("permutations_ii.ads", "permutations_ii.adb");
   for Object_Dir use "obj";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
end Permutations_II_Proof;
