project Water_Bottles_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("water_bottles.ads", "water_bottles.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Water_Bottles_Proof;
