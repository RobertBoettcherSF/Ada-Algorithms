project Design_Underground_System_Lite_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("design_underground_system_lite.ads", "design_underground_system_lite.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Design_Underground_System_Lite_Proof;
