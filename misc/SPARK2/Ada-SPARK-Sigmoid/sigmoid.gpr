project sigmoid is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");
   for Source_Files use ("sigmoid.ads", "sigmoid.adb", "tests.adb", "own_checks.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end sigmoid;
