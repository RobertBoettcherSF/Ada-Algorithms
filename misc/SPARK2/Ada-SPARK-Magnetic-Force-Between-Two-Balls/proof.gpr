project Magnetic_Force_Between_Two_Balls_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("magnetic_force_between_two_balls.ads", "magnetic_force_between_two_balls.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Magnetic_Force_Between_Two_Balls_Proof;
