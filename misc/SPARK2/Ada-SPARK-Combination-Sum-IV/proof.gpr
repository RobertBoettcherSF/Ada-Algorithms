project Combination_Sum_Iv_Proof is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Source_Files use ("combination_sum_iv.ads", "combination_sum_iv.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Combination_Sum_Iv_Proof;
