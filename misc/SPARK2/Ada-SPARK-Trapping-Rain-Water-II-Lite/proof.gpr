project Trapping_Rain_Water_II_Lite_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("trapping_rain_water_ii_lite.ads", "trapping_rain_water_ii_lite.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Trapping_Rain_Water_II_Lite_Proof;
