project Reverse_Bits_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("reversed_bits.ads", "reversed_bits.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Reverse_Bits_Proof;
