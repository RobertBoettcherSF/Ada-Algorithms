project Heap_Push_Pop_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("heap_push_pop.ads", "heap_push_pop.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Heap_Push_Pop_Proof;
