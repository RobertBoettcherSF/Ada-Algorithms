project Tribonacci_Number_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("tribonacci_number.ads", "tribonacci_number.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Tribonacci_Number_Proof;
