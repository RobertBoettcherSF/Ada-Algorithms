project Evaluate_Division_Stub_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("evaluate_division_stub.ads", "evaluate_division_stub.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Evaluate_Division_Stub_Proof;
