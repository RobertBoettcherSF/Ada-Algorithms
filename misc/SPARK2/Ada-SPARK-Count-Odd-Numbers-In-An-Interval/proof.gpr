project Count_Odd_Numbers_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("count_odd_numbers.ads", "count_odd_numbers.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Count_Odd_Numbers_Proof;
