project Kth_Largest_Array_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("kth_largest_array.ads", "kth_largest_array.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Kth_Largest_Array_Proof;
