project Power_Of_Three_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("power_of_three.ads", "power_of_three.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Power_Of_Three_Proof;
