project Replace_Words is
   for Source_Dirs use (".");
   for Main use ("tests.adb");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Source_Files use ("replace_words.ads", "replace_words.adb", "tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
end Replace_Words;
