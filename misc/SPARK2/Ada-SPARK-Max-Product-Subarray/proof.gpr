project Max_Product_Subarray_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("max_product_subarray.ads", "max_product_subarray.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Max_Product_Subarray_Proof;
