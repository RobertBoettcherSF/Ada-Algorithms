project Circular_Deque_Stub_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("circular_deque_stub.ads", "circular_deque_stub.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Circular_Deque_Stub_Proof;
