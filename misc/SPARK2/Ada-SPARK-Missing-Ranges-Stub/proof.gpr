project Missing_Ranges_Stub_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("missing_ranges_stub.ads", "missing_ranges_stub.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Missing_Ranges_Stub_Proof;
