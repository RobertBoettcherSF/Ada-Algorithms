project Product_Of_Array_Except_Self_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("product_of_array_except_self.ads", "product_of_array_except_self.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Product_Of_Array_Except_Self_Proof;
