project Pacific_Atlantic_Water_Stub_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("pacific_atlantic_water_stub.ads", "pacific_atlantic_water_stub.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Pacific_Atlantic_Water_Stub_Proof;
