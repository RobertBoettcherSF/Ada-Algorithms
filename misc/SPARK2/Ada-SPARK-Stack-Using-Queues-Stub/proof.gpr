project Stack_Using_Queues_Stub_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("stack_using_queues_stub.ads", "stack_using_queues_stub.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Stack_Using_Queues_Stub_Proof;
