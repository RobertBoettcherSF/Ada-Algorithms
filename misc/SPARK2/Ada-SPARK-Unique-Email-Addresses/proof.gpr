project Unique_Emails_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("unique_emails.ads", "unique_emails.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Unique_Emails_Proof;
