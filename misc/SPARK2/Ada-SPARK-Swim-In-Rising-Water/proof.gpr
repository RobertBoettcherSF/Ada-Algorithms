project Swim_In_Rising_Water_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("swim_in_rising_water.ads", "swim_in_rising_water.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Swim_In_Rising_Water_Proof;
