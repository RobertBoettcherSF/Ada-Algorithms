project Decode_Ways_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("decode_ways.ads", "decode_ways.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Decode_Ways_Proof;
