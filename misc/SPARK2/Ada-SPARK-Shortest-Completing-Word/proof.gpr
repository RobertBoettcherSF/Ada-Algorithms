project Shortest_Completing_Word_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("shortest_completing_word.ads", "shortest_completing_word.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Shortest_Completing_Word_Proof;
