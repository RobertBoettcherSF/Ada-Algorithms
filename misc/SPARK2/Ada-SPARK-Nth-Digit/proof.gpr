project Nth_Digit_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("nth_digit.ads", "nth_digit.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Nth_Digit_Proof;
