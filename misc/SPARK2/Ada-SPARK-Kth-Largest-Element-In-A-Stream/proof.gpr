project Kth_Largest_Element_In_A_Stream_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("kth_largest_element_in_a_stream.ads", "kth_largest_element_in_a_stream.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Kth_Largest_Element_In_A_Stream_Proof;
