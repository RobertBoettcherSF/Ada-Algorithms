project Find_All_Duplicates_In_An_Array_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("find_all_duplicates_in_an_array.ads", "find_all_duplicates_in_an_array.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Find_All_Duplicates_In_An_Array_Proof;
