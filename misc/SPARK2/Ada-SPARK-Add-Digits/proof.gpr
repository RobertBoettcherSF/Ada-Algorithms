project Add_Digits_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("add_digits.ads", "add_digits.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Add_Digits_Proof;
