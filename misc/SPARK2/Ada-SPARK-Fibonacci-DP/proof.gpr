project Fibonacci_DP_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("fibonacci_dp.ads", "fibonacci_dp.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Fibonacci_DP_Proof;
