project ProductOfNumbersStubProof is
   for Source_Dirs use (".");
   for Source_Files use ("product_of_numbers_stub.ads", "product_of_numbers_stub.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end ProductOfNumbersStubProof;
