project Special_Array_With_X_Elements_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("special_array_with_x_elements.ads", "special_array_with_x_elements.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Special_Array_With_X_Elements_Proof;
