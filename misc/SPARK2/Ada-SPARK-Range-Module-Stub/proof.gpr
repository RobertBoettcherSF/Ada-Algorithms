project Range_Module_Stub_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("range_module_stub.ads", "range_module_stub.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Range_Module_Stub_Proof;
