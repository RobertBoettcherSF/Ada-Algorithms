project Longest_Ones_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("longest_ones.ads", "longest_ones.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Longest_Ones_Proof;
