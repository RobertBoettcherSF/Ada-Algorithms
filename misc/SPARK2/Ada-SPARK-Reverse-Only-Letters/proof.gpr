project Reverse_Only_Letters_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("reverse_only_letters.ads", "reverse_only_letters.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Reverse_Only_Letters_Proof;
