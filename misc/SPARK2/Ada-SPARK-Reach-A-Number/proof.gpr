project Reach_A_Number_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("reach_a_number.ads", "reach_a_number.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Reach_A_Number_Proof;
