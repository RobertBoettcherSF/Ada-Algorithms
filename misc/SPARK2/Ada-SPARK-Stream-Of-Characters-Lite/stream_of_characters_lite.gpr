project Stream_Of_Characters_Lite is
   for Source_Dirs use (".");
   for Main use ("tests.adb");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Source_Files use ("stream_of_characters_lite.ads", "stream_of_characters_lite.adb", "tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
end Stream_Of_Characters_Lite;
