-- tmap.gpr
project TMAP_Project is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnata", "-gnatwa");
      -- -gnata enables assertions (pragma Assert)
      -- -gnatwa enables all warnings
   end Compiler;
end TMAP_Project;
