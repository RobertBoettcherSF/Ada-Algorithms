project Beginner_Board is
   for Source_Dirs use (".");
   for Object_Dir  use "obj";
   for Exec_Dir    use "bin";
   for Main        use ("tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnatwa", "-gnat2022", "-gnata", "-gnatyc");
   end Compiler;

   package Builder is
      for Default_Switches ("Ada") use ("-s");
   end Builder;
end Beginner_Board;
