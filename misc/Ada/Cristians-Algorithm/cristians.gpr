-- cristians.gpr
project Cristians is
   -- Look for source files directly in the root directory (no src/ folder)
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");

   package Compiler is
      -- Enable assertions (-gnata) required for pragma Assert to function
      for Default_Switches ("Ada") use ("-gnata", "-g", "-O2", "-gnatwa");
   end Compiler;
end Cristians;
