-- uca.gpr
project Uca is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("tests.adb", "main.adb");   --  the demo is built by make test too, so it cannot rot
   
   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-gnatwa", "-gnat12");
   end Compiler;
end Uca;
