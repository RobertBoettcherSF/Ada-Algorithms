-- raymonds.gpr
project Raymonds is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb", "tests.adb");
   
   package Compiler is
      -- -gnata enforces pragma Assert statements
      for Default_Switches ("Ada") use ("-g", "-gnata");
   end Compiler;
end Raymonds;
