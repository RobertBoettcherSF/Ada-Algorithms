-- mu_law_project.gpr
-- GNAT Project File for building the Mu-Law test suite

project Mu_Law_Project is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");

   package Compiler is
      -- Enable all warnings and Ada 2012 features
      for Default_Switches ("Ada") use ("-gnat12", "-Wall", "-gnata");
   end Compiler;
end Mu_Law_Project;
