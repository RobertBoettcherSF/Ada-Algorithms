-- vegas.gpr
-- GNAT Project file for compiling the VEGAS framework from the root directory.

project Vegas is
   for Source_Dirs use (".");
   for Object_Dir use ".";
   for Exec_Dir use ".";
   for Main use ("tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnatwa");
   end Compiler;
end Vegas;
