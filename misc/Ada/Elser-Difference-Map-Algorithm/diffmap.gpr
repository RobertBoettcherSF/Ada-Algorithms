-- diffmap.gpr
-- GNAT Project file configured for a flat root directory structure.
project DiffMap is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb", "tests.adb");

   package Compiler is
      for Switches ("Ada") use ("-g", "-O2", "-gnata", "-gnatwa");
   end Compiler;
end DiffMap;
