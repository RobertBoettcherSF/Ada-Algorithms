-- buddy.gpr
-- Version 0.01
-- GNAT Project File

project Buddy is
   for Source_Dirs use ("src", ".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb", "tests.adb");

   package Compiler is
      -- Enable assertions and debugging info
      for Default_Switches ("Ada") use ("-g", "-gnata");
   end Compiler;
end Buddy;
