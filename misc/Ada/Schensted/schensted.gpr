project Schensted is
   for Source_Dirs use (".");
   for Object_Dir  use "obj";
   for Exec_Dir    use "bin";
   for Main        use ("tests.adb");

   package Builder is
      for Default_Switches ("Ada") use ("-s");
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-O2", "-gnatn");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-shared");
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use ();
   end Linker;
end Schensted;
