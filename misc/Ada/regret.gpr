-- regret.gpr
project Regret is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");
   
   package Compiler is
      for Switches ("Ada") use ("-g", "-gnata", "-gnatwa"); 
      -- -gnata enables assertions
   end Compiler;
end Regret;
