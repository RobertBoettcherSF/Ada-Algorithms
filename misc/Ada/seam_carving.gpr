--  seam_carving.gpr
--  GNAT Project File

project Seam_Carving is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb", "tests.adb");
   
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnata", "-gnatwa");
   end Compiler;
end Seam_Carving;
