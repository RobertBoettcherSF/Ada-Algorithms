project Garbage_Collection is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("src/main.adb", "src/tests.adb");

   package Compiler is
      for Switches ("Ada") use ("-g", "-O2", "-gnatwa", "-gnata");
   end Compiler;
end Garbage_Collection;
