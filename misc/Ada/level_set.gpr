-- level_set.gpr
project Level_Set is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb", "tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnata"); -- -gnata enables assertions
   end Compiler;
end Level_Set;
