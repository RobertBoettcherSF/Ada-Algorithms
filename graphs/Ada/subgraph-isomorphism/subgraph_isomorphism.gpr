--  subgraph_isomorphism.gpr
--  GNAT Project File for Subgraph Isomorphism Problem
--
--  This project file configures the compilation of the subgraph isomorphism package
--  and the test program. It specifies:
--  - Source directory: src/
--  - Object directory: obj/
--  - Executable directory: bin/
--  - Main program: test_subgraph.adb
--
--  Compilation:
--    gnatmake -P subgraph_isomorphism.gpr
--
--  Running tests:
--    ./bin/test_subgraph
--
--  Author: Robert Boettcher
--  Date: July 29, 2026

project Subgraph_Isomorphism is
   -- Directory containing Ada source files
   for Source_Dirs use ("src");

   -- Directory for compiled object files
   for Object_Dir use "obj";

   -- Directory for executable files
   for Exec_Dir use "bin";

   -- Main program to compile and run
   for Main use ("test_subgraph.adb");
end Subgraph_Isomorphism;
