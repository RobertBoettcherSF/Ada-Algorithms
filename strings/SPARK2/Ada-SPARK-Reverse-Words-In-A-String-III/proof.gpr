project Reverse_Words_In_A_String_III_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("reverse_words_in_a_string_iii.ads", "reverse_words_in_a_string_iii.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Reverse_Words_In_A_String_III_Proof;
