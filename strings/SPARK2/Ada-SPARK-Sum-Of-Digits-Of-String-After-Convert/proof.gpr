project Sum_Digits_Convert_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("sum_digits_convert.ads", "sum_digits_convert.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Sum_Digits_Convert_Proof;
