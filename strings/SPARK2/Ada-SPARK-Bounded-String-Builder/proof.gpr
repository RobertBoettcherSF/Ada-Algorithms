project Bounded_String_Builder_Proof is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Source_Files use
     ("bounded_string_builder.ads",
      "bounded_string_builder.adb",
      "spark_instances.ads");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Bounded_String_Builder_Proof;
