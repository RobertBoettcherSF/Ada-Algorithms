project Equivalent_String_Arrays_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("equivalent_string_arrays.ads", "equivalent_string_arrays.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Equivalent_String_Arrays_Proof;
