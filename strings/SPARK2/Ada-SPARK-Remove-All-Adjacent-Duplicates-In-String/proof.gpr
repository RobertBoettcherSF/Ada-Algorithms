project Remove_All_Adjacent_Duplicates_In_String_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("remove_all_adjacent_duplicates_in_string.ads", "remove_all_adjacent_duplicates_in_string.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Remove_All_Adjacent_Duplicates_In_String_Proof;
