project Write_String_Lines_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("write_string_lines.ads", "write_string_lines.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Write_String_Lines_Proof;
