project Rotate_String_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("rotate_string.ads", "rotate_string.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Rotate_String_Proof;
