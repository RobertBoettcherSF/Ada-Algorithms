project Repeated_String_Match_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("repeated_string_match.ads", "repeated_string_match.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Repeated_String_Match_Proof;
