project Multiply_Strings_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("multiply_strings.ads", "multiply_strings.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Multiply_Strings_Proof;
