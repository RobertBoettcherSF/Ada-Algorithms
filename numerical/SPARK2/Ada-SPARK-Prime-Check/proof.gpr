project Prime_Check_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("prime_check.ads", "prime_check.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Prime_Check_Proof;
