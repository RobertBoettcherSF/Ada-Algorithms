project Count_Primes_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("count_primes.ads", "count_primes.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Count_Primes_Proof;
