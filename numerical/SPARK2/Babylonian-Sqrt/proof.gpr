project Babylonian_Sqrt_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("babylonian_sqrt.ads", "babylonian_sqrt.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Babylonian_Sqrt_Proof;
