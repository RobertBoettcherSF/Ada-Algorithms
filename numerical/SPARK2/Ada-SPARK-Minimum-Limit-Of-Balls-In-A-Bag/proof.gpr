project Minimum_Limit_Of_Balls_In_A_Bag_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("minimum_limit_of_balls_in_a_bag.ads", "minimum_limit_of_balls_in_a_bag.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Minimum_Limit_Of_Balls_In_A_Bag_Proof;
