project Perfect_Number_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("perfect_number.ads", "perfect_number.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Perfect_Number_Proof;
