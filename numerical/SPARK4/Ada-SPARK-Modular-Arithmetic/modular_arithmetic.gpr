--  Version: 0.001
--  Project file used by GNATprove (make prove).  The build itself uses
--  plain gnatmake (see Makefile), so this file is optional for building.

project Modular_Arithmetic is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=4");
   end Prove;
end Modular_Arithmetic;
