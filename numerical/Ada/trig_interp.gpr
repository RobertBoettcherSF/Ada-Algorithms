-- trig_interp.gpr
project Trig_Interp is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb", "tests.adb");
   
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat12", "-gnata", "-gnatwa");
   end Compiler;
end Trig_Interp;
