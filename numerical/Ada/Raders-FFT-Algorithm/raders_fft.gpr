project Raders_Fft is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb", "tests.adb");

   package Compiler is
      -- gnata enables runtime assertions critically needed for V&V
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnata");
   end Compiler;
end Raders_Fft;
