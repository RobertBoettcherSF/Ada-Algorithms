project Intro_Sort_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("intro_sort.ads", "intro_sort.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Intro_Sort_Proof;
