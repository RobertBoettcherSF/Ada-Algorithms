project Sort_Characters_By_Frequency_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("sort_characters_by_frequency.ads", "sort_characters_by_frequency.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Sort_Characters_By_Frequency_Proof;
