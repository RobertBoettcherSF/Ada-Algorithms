project Remove_Duplicates_From_Sorted_Array_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("remove_duplicates_from_sorted_array.ads", "remove_duplicates_from_sorted_array.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Remove_Duplicates_From_Sorted_Array_Proof;
