project Kth_Smallest_Matrix_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("kth_smallest_matrix.ads", "kth_smallest_matrix.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Kth_Smallest_Matrix_Proof;
