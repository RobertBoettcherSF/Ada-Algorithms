project Proof is
   for Source_Dirs use (".");
   for Source_Files use ("merge_two_sorted_lists.ads", "merge_two_sorted_lists.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Proof;
