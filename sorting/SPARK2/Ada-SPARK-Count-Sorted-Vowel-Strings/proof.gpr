project Count_Sorted_Vowel_Strings_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("count_sorted_vowel_strings.ads", "count_sorted_vowel_strings.adb");
   for Object_Dir use "obj";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Count_Sorted_Vowel_Strings_Proof;
