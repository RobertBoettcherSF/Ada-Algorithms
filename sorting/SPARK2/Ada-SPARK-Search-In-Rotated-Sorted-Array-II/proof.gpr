project Search_In_Rotated_Sorted_Array_II_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("search_in_rotated_sorted_array_ii.ads", "search_in_rotated_sorted_array_ii.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Search_In_Rotated_Sorted_Array_II_Proof;
