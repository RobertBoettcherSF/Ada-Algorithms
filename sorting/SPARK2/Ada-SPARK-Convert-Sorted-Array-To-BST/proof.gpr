project Convert_Sorted_Array_To_BST_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("convert_sorted_array_to_bst.ads", "convert_sorted_array_to_bst.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Convert_Sorted_Array_To_BST_Proof;
