project Sort_An_Array_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("sort_an_array.ads", "sort_an_array.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Sort_An_Array_Proof;
