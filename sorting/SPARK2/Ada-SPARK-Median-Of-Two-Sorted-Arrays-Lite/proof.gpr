project Median_Of_Two_Sorted_Arrays_Lite_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("median_of_two_sorted_arrays_lite.ads", "median_of_two_sorted_arrays_lite.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Median_Of_Two_Sorted_Arrays_Lite_Proof;
