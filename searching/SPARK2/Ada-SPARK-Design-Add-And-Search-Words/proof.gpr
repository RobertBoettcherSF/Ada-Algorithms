project DesignAddAndSearchWords_Build_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("design_add_and_search_words.ads", "design_add_and_search_words.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end DesignAddAndSearchWords_Build_Proof;
