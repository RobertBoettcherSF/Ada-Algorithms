project Design_Add_And_Search_Words is
   for Source_Dirs use (".");
   for Main use ("tests.adb", "own_checks.adb", "full_insert_check.adb");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Source_Files use ("design_add_and_search_words.ads", "design_add_and_search_words.adb", "tests.adb", "own_checks.adb", "full_insert_check.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Design_Add_And_Search_Words;
