project Binary_Search_Lower_Bound_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("binary_search_lower_bound.ads", "binary_search_lower_bound.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Binary_Search_Lower_Bound_Proof;
