project WordSearchIiLite_Build_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("word_search_ii_lite.ads", "word_search_ii_lite.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end WordSearchIiLite_Build_Proof;
