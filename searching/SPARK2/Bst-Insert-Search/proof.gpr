project BST_Insert_Search_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("bst_insert_search.ads", "bst_insert_search.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end BST_Insert_Search_Proof;
