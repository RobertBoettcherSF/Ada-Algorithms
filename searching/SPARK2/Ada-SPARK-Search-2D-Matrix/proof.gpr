project Search_2D_Matrix_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("search_2d_matrix.ads", "search_2d_matrix.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Search_2D_Matrix_Proof;
