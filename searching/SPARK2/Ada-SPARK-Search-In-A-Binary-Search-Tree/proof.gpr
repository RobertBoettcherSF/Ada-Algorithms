project Proof is
   for Source_Dirs use (".");
   for Source_Files use ("search_in_a_binary_search_tree.ads", "search_in_a_binary_search_tree.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Proof;
