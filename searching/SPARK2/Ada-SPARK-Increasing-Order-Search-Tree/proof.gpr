project Increasing_Order_Search_Tree_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("increasing_order_search_tree.ads", "increasing_order_search_tree.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Increasing_Order_Search_Tree_Proof;
