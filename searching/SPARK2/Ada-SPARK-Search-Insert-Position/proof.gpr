project Search_Insert_Position_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("search_insert_position.ads", "search_insert_position.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Search_Insert_Position_Proof;
