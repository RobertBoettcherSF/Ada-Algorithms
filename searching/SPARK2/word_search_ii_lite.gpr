project Word_Search_Ii_Lite is
   for Source_Dirs use (".");
   for Main use ("tests.adb");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Source_Files use ("word_search_ii_lite.ads", "word_search_ii_lite.adb", "tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;
end Word_Search_Ii_Lite;
