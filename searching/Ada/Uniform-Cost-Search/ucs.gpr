project Ucs is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");
   
   package Compiler is
      -- Enable assertions (-gnata), warnings, and Ada 2012 features
      for Default_Switches ("Ada") use ("-g", "-gnata", "-gnatwa", "-gnat12");
   end Compiler;
end Ucs;
