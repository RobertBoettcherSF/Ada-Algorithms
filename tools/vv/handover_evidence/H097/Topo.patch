+   -------------------------------------------------------------------------
+   Section ("16. Every graph on up to 4 nodes vs own reference (agent A3)");
+   -------------------------------------------------------------------------
+   --  Reference written for this test: a graph has a directed cycle
+   --  iff a depth-first walk meets a node that is still on its path
+   --  (white / grey / black colours). A permutation is a valid order
+   --  iff every edge goes to a later position. For every graph with
+   --  N = 1 .. 4 (all 2^(N*N) edge sets): Success must equal "no
+   --  cycle", Success gives Is_Valid_Sort, failure gives Is_Blocked
+   --  for some K, Is_Blocked never holds on a DAG, and Is_Valid_Sort
+   --  must agree with the reference on all N! permutations.
+   declare
+      type Colour is (White, Grey, Black);
+      type Colour_Array is array (Node_Id) of Colour;
+
+      function Has_Cycle (G : Graph) return Boolean is
+         C     : Colour_Array := [others => White];
+         Found : Boolean := False;
+
+         procedure Visit (U : Node_Id) is
+         begin
+            C (U) := Grey;
+            for V in 1 .. G.Num_Nodes loop
+               if G.Adj (U, V) then
+                  if C (V) = Grey then
+                     Found := True;
+                  elsif C (V) = White then
+                     Visit (V);
+                  end if;
+               end if;
+            end loop;
+            C (U) := Black;
+         end Visit;
+      begin
+         for U in 1 .. G.Num_Nodes loop
+            if C (U) = White then
+               Visit (U);
+            end if;
+         end loop;
+         return Found;
+      end Has_Cycle;
+
+      function Ref_Valid (G : Graph; P : Node_Array) return Boolean is
+         Pos : array (Node_Id) of Natural := [others => 0];
+      begin
+         for I in P'Range loop
+            Pos (P (I)) := I;
+         end loop;
+         for U in 1 .. G.Num_Nodes loop
+            for V in 1 .. G.Num_Nodes loop
+               if G.Adj (U, V) and then Pos (U) >= Pos (V) then
+                  return False;
+               end if;
+            end loop;
+         end loop;
+         return True;
+      end Ref_Valid;
+
+      Graphs, DAGs, Bad_Succ, Bad_Valid, Bad_Block, Bad_Judge : Natural := 0;
+      Perm_Valid : Natural := 0;
+   begin
+      for N in 1 .. 4 loop
+         declare
+            Cells : constant Natural := N * N;
+            G     : Graph (N);
+            R     : Node_Array (1 .. N);
+            S     : Boolean;
+            P     : Node_Array (1 .. N);
+            Used  : array (1 .. N) of Boolean;
+
+            procedure Perms (I : Positive; Cycle : Boolean) is
+            begin
+               if I > N then
+                  if Is_Valid_Sort (G, P) /= Ref_Valid (G, P) then
+                     Bad_Judge := Bad_Judge + 1;
+                  end if;
+                  if Is_Valid_Sort (G, P) then
+                     Perm_Valid := Perm_Valid + 1;
+                     if Cycle then
+                        Bad_Judge := Bad_Judge + 1;
+                     end if;
+                  end if;
+                  return;
+               end if;
+               for V in 1 .. N loop
+                  if not Used (V) then
+                     Used (V) := True;
+                     P (I) := V;
+                     Perms (I + 1, Cycle);
+                     Used (V) := False;
+                  end if;
+               end loop;
+            end Perms;
+         begin
+            for Mask in 0 .. 2 ** Cells - 1 loop
+               Clear (G);
+               for C in 0 .. Cells - 1 loop
+                  if (Mask / 2 ** C) mod 2 = 1 then
+                     Add_Edge (G, C / N + 1, C mod N + 1);
+                  end if;
+               end loop;
+               Graphs := Graphs + 1;
+               declare
+                  Cyc     : constant Boolean := Has_Cycle (G);
+                  Blocked : Boolean := False;
+               begin
+                  if not Cyc then
+                     DAGs := DAGs + 1;
+                  end if;
+                  Kahn_Sort (G, R, S);
+                  if S = Cyc then
+                     Bad_Succ := Bad_Succ + 1;
+                  end if;
+                  if S and then not Is_Valid_Sort (G, R) then
+                     Bad_Valid := Bad_Valid + 1;
+                  end if;
+                  for K in 0 .. N loop
+                     Blocked := Blocked or else Is_Blocked (G, R, K);
+                  end loop;
+                  if Blocked /= Cyc then
+                     Bad_Block := Bad_Block + 1;
+                  end if;
+                  Used := [others => False];
+                  Perms (1, Cyc);
+               end;
+            end loop;
+         end;
+      end loop;
+      Put_Line ("  graphs" & Graphs'Image & ", DAGs" & DAGs'Image
+                & ", valid permutations" & Perm_Valid'Image);
+      Check (Graphs = 2 + 16 + 512 + 65536, "all graphs on 1 .. 4 nodes");
+      Check (Bad_Succ = 0, "Success = no cycle on every graph");
+      Check (Bad_Valid = 0, "Success gives Is_Valid_Sort");
+      Check (Bad_Block = 0, "Is_Blocked for some K iff a cycle");
+      Check (Bad_Judge = 0,
+             "Is_Valid_Sort = reference on every permutation");
+   end;
+
    New_Line;
    Put_Line
      ("Results: " & Pass_Count'Image & " PASS," & Fail_Count'Image
