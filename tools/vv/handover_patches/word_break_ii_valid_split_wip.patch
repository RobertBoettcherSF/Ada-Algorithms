diff --git a/misc/SPARK2/Ada-SPARK-Word-Break-II/word_break_ii.ads b/misc/SPARK2/Ada-SPARK-Word-Break-II/word_break_ii.ads
index a08d66a3..3decd9be 100644
--- a/misc/SPARK2/Ada-SPARK-Word-Break-II/word_break_ii.ads
+++ b/misc/SPARK2/Ada-SPARK-Word-Break-II/word_break_ii.ads
@@ -46,11 +46,37 @@ package Word_Break_II is
      return Sentence_Count
      with Global => null;
 
+   --  B splits S (P .. N) into dictionary words (B (E): a word ends at
+   --  E): no break after N, a break at N (unless P > N), and every stretch
+   --  from a start Q + 1 (Q = P - 1, or a break at Q) to the next break E
+   --  is a dictionary word S (Q + 1 .. E). Universal quantifiers only.
+   function Valid_From
+     (S : Text; N : Text_Length; D : Dictionary; DC : Word_Count; B : Break_Set; P : Positive)
+     return Boolean is
+     ((for all R in N + 1 .. Max_Len => not B (R))
+      and then (if P <= N then B (N))
+      and then (for all Q in P - 1 .. N - 1 =>
+                  (for all E in Q + 1 .. N =>
+                     (if (Q = P - 1 or else B (Q)) and then B (E)
+                         and then (for all R in Q + 1 .. E - 1 => not B (R))
+                      then E - Q <= Max_Word_Len and then In_Dict (S, Q + 1, E - Q, D, DC)))))
+     with Global => null, Pre => P <= N + 1;
+
+   --  B (a word ends at each True position) splits S (1 .. N) into words.
+   function Valid_Split
+     (S : Text; N : Text_Length; D : Dictionary; DC : Word_Count; B : Break_Set) return Boolean is
+     (Valid_From (S, N, D, DC, B, 1))
+     with Global => null;
+
+   --  Every listed break set is a split into dictionary words, and there
+   --  are Count_Sentences of them (that they are pairwise different is
+   --  checked by own_checks only, see tools/vv/contract_scan.csv).
    procedure Sentences
      (S : Text; N : Text_Length; D : Dictionary; DC : Word_Count;
       List : out Sentence_List; Count : out Sentence_Count)
      with Global => null,
-          Post   => Count = Count_Sentences (S, N, D, DC);
+          Post   => Count = Count_Sentences (S, N, D, DC)
+                    and then (for all K in 1 .. Count => Valid_Split (S, N, D, DC, List (K)));
 private
    --  Ways (P) = number of ways to split S (P .. N) into words; Ways (N + 1) = 1.
    subtype Ext_Position is Positive range 1 .. Max_Len + 1;
