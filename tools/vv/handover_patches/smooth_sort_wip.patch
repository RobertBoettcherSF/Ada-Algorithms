---  PLACEHOLDER: fixed 8-element bubble sort under a smoothsort name; the Post only bounds the elements; see H107
 pragma Ada_2022;
 
+--  Smoothsort of 8 values (E. W. Dijkstra, "Smoothsort, an alternative for
+--  sorting in situ", EWD796a, 1981), in the variant that restores the root
+--  order after every insertion. The prefix A (1 .. N) is a forest of
+--  Leonardo heaps ("stretches" of sizes L (0 .. 3) = 1, 1, 3, 5; 8 keys
+--  never need order 4), roots ascending from left to right. A stretch of
+--  order K >= 2 rooted at R has the right child stretch of order K - 2
+--  rooted at R - 1 and the left child of order K - 1 rooted at
+--  R - 1 - L (K - 2). Insertion of key N: if the last two stretches have
+--  orders k + 1 and k they become, with N, one stretch of order k + 2;
+--  else N is a stretch of order 1 (order 0 after an order-1 stretch); then
+--  trinkle. Trinkle at stretch J: while the previous root is larger than
+--  the root of J and than both child roots of J, exchange the two roots
+--  and go to J - 1; then sift J (exchange the root with its larger child
+--  root, the left one on ties, while that child is larger). Teardown: the
+--  last root is the maximum of the prefix and stays in place; a stretch of
+--  order >= 2 leaves its two children as stretches, trinkled left, then
+--  right.
 package Smooth_Sort with SPARK_Mode => On is
    subtype Index is Positive range 1 .. 8;
    subtype Value is Integer range 0 .. 31;
    type Input_Array is array (Index) of Value;
 
+   --  Every exchange (X, Y) in order: at most 9 per insertion (a trinkle
+   --  passes at most 7 roots, a sift at most 2 levels) and 18 per removal.
+   Max_Swaps : constant := 200;
+   type Swap_Pair is record
+      X, Y : Index;
+   end record;
+   type Swap_Log is array (1 .. Max_Swaps) of Swap_Pair;
+
+   --  How many of A (1 .. Last) equal V.
+   function Occ (A : Input_Array; V : Value; Last : Natural) return Natural
+   with Global             => null,
+        Pre                => Last <= Index'Last,
+        Post               => Occ'Result <= Last,
+        Subprogram_Variant => (Decreases => Last);
+
+   function Occ (A : Input_Array; V : Value; Last : Natural) return Natural is
+     (if Last = 0 then 0
+      else Occ (A, V, Last - 1) + (if A (Last) = V then 1 else 0));
+
+   --  A and B hold the same values, each equally often (Value has 32
+   --  elements, so this is cheap to check at run time).
+   function Is_Perm (A, B : Input_Array) return Boolean is
+     (for all V in Value => Occ (A, V, Index'Last) = Occ (B, V, Index'Last))
+   with Global => null;
+
+   function Is_Sorted (A : Input_Array) return Boolean is
+     (for all I in Index'First .. Index'Last - 1 => A (I) <= A (I + 1))
+   with Global => null;
+
+   --  Sort, also returning every exchange (Log (1 .. Count)).
+   procedure Sort_Traced
+     (Input : Input_Array; Output : out Input_Array; Log : out Swap_Log; Count : out Natural)
+     with Global => null,
+          Post   => Is_Sorted (Output) and then Is_Perm (Output, Input) and then Count <= Max_Swaps;
+
    function Sort (Input : Input_Array) return Input_Array
      with Global => null,
-          Post => (for all I in Index => Sort'Result (I) in Value);
+          Post   => Is_Sorted (Sort'Result) and then Is_Perm (Sort'Result, Input);
 end Smooth_Sort;
