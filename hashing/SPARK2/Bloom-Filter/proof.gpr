project Bloom_Filter_Proof is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Source_Files use ("bloom_filter.ads", "bloom_filter.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Bloom_Filter_Proof;
