project Design_HashMap_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("design_hashmap.ads", "design_hashmap.adb");
   package Prove is
      --  Proof warnings on by default (tools/vv/prove_settings.txt)
      for Proof_Switches ("Ada") use ("--proof-warnings=on", "--proof-warnings-timeout=10");
   end Prove;
end Design_HashMap_Proof;
